NODE_ENV=development
PORT=3333

# PostgreSQL local (docker compose up -d) OU URL de um serviço gerido
# (Supabase / Neon / Railway / Render / Fly) em produção.
DATABASE_URL="postgresql://isptec:isptec@localhost:5432/isptec_news?schema=public"

# Segurança (gerar um segredo forte em produção)
JWT_SECRET="dev-secret-trocar-em-producao"

# CORS: origem(ns) permitida(s), separadas por vírgula. * = todas (apenas dev)
CORS_ORIGIN="http://localhost:5173"

# Pasta de media (relativa à raiz da API)
MEDIA_DIR="../../media"

# PKI / Autoridade Certificadora (ver docs/SEGURANCA-PKI.md)
# Pasta das chaves da CA (gerar com `pnpm ca:init`).
PKI_DIR="./.pki"
# true → exige certificado de dispositivo (anti-pirataria/MITM). Em dev fica false.
PKI_ENFORCE="false"
