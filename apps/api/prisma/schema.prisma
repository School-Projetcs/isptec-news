// ISPTEC News — modelo de dados
// Docs: docs/00-plano-mestre.md (secção 9)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  READER
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

enum MediaType {
  IMAGE
  AUDIO
  VIDEO
}

enum MediaStatus {
  UPLOADED
  PROCESSING
  READY
  ERROR
}

// Estado de um dispositivo na PKI.
//  ACTIVE  = tem certificado válido emitido pela CA.
//  REVOKED = certificado revogado (deixa de poder conectar) — base do não-repúdio.
//  BYPASS  = máquina autorizada SEM certificado (lista de exceção criada no servidor).
enum DeviceStatus {
  ACTIVE
  REVOKED
  BYPASS
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(READER)
  news         News[]
  media        Media[]
  comments     Comment[]
  saved        SavedNews[]
  logs         Log[]
  devices      Device[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Category {
  id    String  @id @default(cuid())
  name  String
  slug  String  @unique
  // Departamento/agrupamento visual (ex.: "Engenharia", "Ciências Sociais",
  // "Geociências", "Geral"). Usado para agrupar as categorias na UI (optgroups).
  group String?
  news  News[]
}

model News {
  id           String     @id @default(cuid())
  title        String
  slug         String     @unique
  summary      String     @default("")
  body         String
  status       NewsStatus @default(DRAFT)
  viewCount    Int        @default(0)
  author       User       @relation(fields: [authorId], references: [id])
  authorId     String
  category     Category?  @relation(fields: [categoryId], references: [id])
  categoryId   String?
  cover        Media?     @relation("NewsCover", fields: [coverMediaId], references: [id])
  coverMediaId String?    @unique
  media        Media[]    @relation("NewsMedia")
  comments     Comment[]
  savedBy      SavedNews[]
  signature    ContentSignature?
  publishedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Media {
  id           String         @id @default(cuid())
  type         MediaType
  originalName String
  originalPath String
  originalSize Int
  mimeType     String
  status       MediaStatus    @default(UPLOADED)
  durationMs   Int?
  width        Int?
  height       Int?
  owner        User           @relation(fields: [ownerId], references: [id])
  ownerId      String
  news         News?          @relation("NewsMedia", fields: [newsId], references: [id])
  newsId       String?
  coverOf      News?          @relation("NewsCover")
  variants     MediaVariant[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// Cada variante = uma versão processada/comprimida do media original.
// Materializa o RELATÓRIO COMPARATIVO de compressão exigido pelo professor.
model MediaVariant {
  id               String   @id @default(cuid())
  media            Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId          String
  label            String // ex: "webp-q80", "h264-720p", "mp3-128k", "huffman-own"
  format           String // ex: "webp", "mp4", "mp3"
  codec            String? // ex: "h264", "h265", "vp9", "aac"
  path             String
  size             Int
  compressionRatio Float    @default(0) // tamanho original / tamanho comprimido
  processingMs     Int      @default(0)
  qualityScore     Float? // ex: PSNR (imagem)
  width            Int?
  height           Int?
  bitrateKbps      Int?
  createdAt        DateTime @default(now())
}

// Notícia guardada por um utilizador ("Guardadas"). Junção N:N user↔news,
// única por par (não dá para guardar a mesma notícia duas vezes).
model SavedNews {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  newsId    String
  createdAt DateTime @default(now())

  @@unique([userId, newsId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  newsId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
}

// Dispositivo registado na PKI. Materializa o "registo de certificados" da CA:
// guarda a chave pública certificada, o nº de série e o estado (ativo/revogado/bypass).
// O servidor consulta-o no handshake para aceitar/recusar e para revogar.
model Device {
  id         String       @id @default(cuid())
  deviceId   String       @unique // identificador apresentado pelo cliente
  label      String // etiqueta legível (ex.: "Portátil do Dálcio")
  status     DeviceStatus @default(ACTIVE)
  publicKey  String? // chave pública do dispositivo (base64 SPKI DER); nula em BYPASS
  serial     String?      @unique // nº de série do certificado; nulo em BYPASS
  certJson   String? // certificado completo emitido (JSON); nulo em BYPASS
  notBefore  DateTime?
  notAfter   DateTime?
  user       User?        @relation(fields: [userId], references: [id])
  userId     String?
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

// Assinatura de autoria de uma notícia (NÃO-REPÚDIO).
// Prova criptográfica de que um dispositivo certificado de um utilizador concreto
// produziu aquele conteúdo. Verificável por qualquer pessoa com a chave pública do cert.
model ContentSignature {
  id        String   @id @default(cuid())
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  newsId    String   @unique
  deviceId  String // dispositivo que assinou
  certSerial String? // nº de série do certificado usado
  algo      String   @default("ECDSA-P256-SHA256")
  hash      String // SHA-256 (hex) da mensagem canónica assinada
  signature String // assinatura (base64) sobre a mensagem canónica
  signedAt  DateTime @default(now())
}

// Registo de logs (requisito obrigatório do servidor).
model Log {
  id         String   @id @default(cuid())
  level      String   @default("info")
  action     String
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
  ip         String?
  method     String?
  path       String?
  statusCode Int?
  message    String?
  createdAt  DateTime @default(now())
}
