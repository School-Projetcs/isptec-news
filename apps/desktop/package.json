{
  "name": "@isptec/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Cliente Desktop (Electron) — embrulha a app Web do ISPTEC News",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron . http://localhost:5173",
    "start": "electron .",
    "build:web": "pnpm --filter @isptec/web build",
    "dist": "pnpm --filter @isptec/web build && electron-builder",
    "dist:dir": "pnpm --filter @isptec/web build && electron-builder --dir"
  },
  "build": {
    "appId": "ao.isptec.news",
    "productName": "ISPTEC News",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.news"
    },
    "linux": {
      "target": "AppImage",
      "category": "News"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1"
  }
}
