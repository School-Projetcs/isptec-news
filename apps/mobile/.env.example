# URL da API. O Expo expõe variáveis com prefixo EXPO_PUBLIC_ ao código do cliente.
#
#  • Emulador Android:   http://10.0.2.2:3333
#  • Telemóvel físico:   http://<IP-LAN-da-tua-máquina>:3333  (ex.: http://192.168.1.50:3333)
#  • iOS Simulator:      http://localhost:3333
EXPO_PUBLIC_API_URL=http://localhost:3333
