{
  "name": "isptec-news",
  "version": "0.1.0",
  "private": true,
  "description": "ISPTEC News — Plataforma de Notícias Multimédia (Multimédia 2026, Grupo 26)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-env.mjs && pnpm db:generate",
    "start:all": "node scripts/start-all.mjs",
    "start:all:tunnel": "node scripts/start-all.mjs --tunnel",
    "predev": "node scripts/ensure-env.mjs",
    "dev": "pnpm --parallel --filter @isptec/api --filter @isptec/web dev",
    "dev:api": "pnpm --filter @isptec/api dev",
    "dev:web": "pnpm --filter @isptec/web dev",
    "dev:desktop": "pnpm --filter @isptec/desktop dev",
    "dev:mobile": "node scripts/dev-mobile.mjs",
    "dev:tunnel": "node scripts/dev-tunnel.mjs",
    "desktop": "pnpm --filter @isptec/web build && pnpm --filter @isptec/desktop start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:generate": "pnpm --filter @isptec/api db:generate",
    "db:migrate": "pnpm --filter @isptec/api db:migrate",
    "db:seed": "pnpm --filter @isptec/api db:seed",
    "db:studio": "pnpm --filter @isptec/api db:studio",
    "ca:init": "pnpm --filter @isptec/api ca:init",
    "cert:issue": "pnpm --filter @isptec/api cert:issue",
    "cert:list": "pnpm --filter @isptec/api cert:list",
    "cert:revoke": "pnpm --filter @isptec/api cert:revoke",
    "cert:bypass": "pnpm --filter @isptec/api cert:bypass"
  },
  "devDependencies": {
    "cloudflared": "^0.7.1",
    "typescript": "^5.7.2"
  }
}
